NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server only. NEVER prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=YOUR_GOOGLE_AI_STUDIO_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVER_SERVICE_ROLE_KEY

# Member invitations reuse SUPABASE_SERVICE_ROLE_KEY on the server only.
# Supabase Auth: allow your production /join** redirect (and localhost for development).
# Invite/Recovery email templates must retain {{ .ConfirmationURL }}; configure SMTP for actual members.

# Claim notification emails (server only). Gmail needs 2-Step Verification + an App Password.
# APP_URL is the canonical website origin used in email links, e.g. https://moneylai.example.com
APP_URL=http://localhost:3000
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Random secret for the protected GET /api/notifications/dispatch scheduler endpoint.
CRON_SECRET=
